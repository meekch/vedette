# Vedette — environment variables (NAMES ONLY; never commit real values).
# Copy to .env.local and fill in. .env.local is gitignored.
#
# The demo runs with NONE of these set. Keys are needed only to regenerate the
# analysis snapshot (`npm run analyze`) and for Phase 2 onward.
#
# One line per variable. Duplicate declarations shadow each other silently —
# dotenv keeps the LAST occurrence, so a stray empty re-declaration further down
# the file will blank out a real value above it without any warning.

# ── Chat model (ADR-003) — required only for `npm run analyze` ──
# Provider is auto-detected from whichever key is present, preferring Anthropic.
ANTHROPIC_API_KEY=
# Optional overrides. VEDETTE_CHAT_PROVIDER is "anthropic" | "openai".
# VEDETTE_CHAT_MODEL is required when the provider is openai (no pinned default).
VEDETTE_CHAT_PROVIDER=
VEDETTE_CHAT_MODEL=

# ── Clerk (auth + organizations) — ADR-002, Phase 1 step 2, not yet wired ──
# From the Clerk dashboard → API keys. The publishable key is public (client);
# the secret key is server-only and must never reach the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret for the Clerk → /api/webhooks/clerk endpoint (user/org sync).
CLERK_WEBHOOK_SIGNING_SECRET=

# ── Supabase (Postgres + pgvector + storage) — Phase 2 ──
# URL and anon key are safe for the browser (RLS-enforced). The service-role key
# BYPASSES RLS — server-only, used solely by Clerk webhooks + ingestion jobs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI (embeddings per ADR-005) — Phase 2 ──
OPENAI_API_KEY=

# ── Postgres connection (migration push + RLS test) ──
# Supabase dashboard → Project Settings → Database → Connection string.
#
# Use the SESSION POOLER: postgres.<ref>@aws-N-<region>.pooler.supabase.com:5432
#   * The direct host (db.<ref>.supabase.co) is IPv6-only on current projects and
#     fails with ENOTFOUND / ENETUNREACH from any IPv4-only network.
#   * The session pooler is on port 5432 and preserves SET ROLE / session
#     semantics, which the RLS test in tests/rls.test.ts depends on.
#   * Do NOT use the transaction pooler on 6543 — it drops those semantics.
DATABASE_URL=
